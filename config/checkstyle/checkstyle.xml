<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Layout belongs to the formatter and correctness to Error Prone. This counts the two things
     neither can see: how long a method is, and how many things it is handed. Note that
     ParameterNumber cannot see a record at all (it refuses RECORD_DEF), so the constructor
     count lives in ArchitectureTest, where ArchUnit reads bytecode and a record is a class. -->
<module name="Checker">
  <property name="severity" value="warning"/>
  <property name="charset" value="UTF-8"/>
  <module name="SuppressionFilter">
    <property name="file" value="${config_loc}/suppressions.xml"/>
  </module>
  <module name="TreeWalker">
    <module name="MethodLength">
      <property name="max" value="25"/>
      <property name="countEmpty" value="false"/>
    </module>

    <!-- Four, for everything. A helper exists because a longer method was split, so it gets
         handed what the pieces need. The tighter rule for the visible surface is three, and it
         lives in ArchitectureTest: Checkstyle's xpath filter will not suppress by check id, so it
         cannot tell a private helper from public API, and ArchUnit reads the modifiers. -->
    <module name="ParameterNumber">
      <property name="max" value="4"/>
    </module>

    <!-- How many branches a method has, and how many paths through it. Checkstyle ships both,
         so this needed no new tool. 10 is the conventional limit and the code is under it: the
         one method over was Supersession.prose at 13, and it was split rather than excused.

         BooleanExpressionComplexity was tried and rejected. Its only finding was the five-clause
         guard in Supersession.replaces, and a named predicate spelling out five conditions is
         what you refactor complexity *into*. A rule that pushes you to break one up makes the
         code worse. -->
    <module name="CyclomaticComplexity">
      <property name="max" value="10"/>
    </module>
    <module name="NPathComplexity">
      <property name="max" value="200"/>
    </module>

  </module>
</module>
